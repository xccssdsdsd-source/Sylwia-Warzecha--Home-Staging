{
  "$schema": "https://unpkg.com/wrangler@4.152.0/config-schema.json",
  "name": "styli-staging",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "CONTACT",
      "id": "f01f201555f04528ad3849543fc0ea93"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  }
}
